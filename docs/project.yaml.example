# Routly documented project configuration.
# Read this file before editing config/project.yaml.
# The real config/project.yaml is intentionally comment-free.

project:
  project_root: "."          # Repository root used to resolve relative paths.
  seed: 71                   # Global seed for repeatable random choices.

experiment:
  name_prefix: "experiment"  # Prefix used when creating a new experiment folder.

osm:
  place_name: "Bologna, Emilia-Romagna, Italy"  # OSM place queried by OSMnx.
  network_type: "drive"                         # OSMnx road network type.

graph_simplification:
  keep_largest_component: true  # Keep only the largest connected component.
  remove_isolated_nodes: true   # Drop nodes that cannot be used by routing.
  distance_meters: 1000         # Crop radius around the selected area.
  max_nodes: 500                # Maximum graph nodes kept after simplification.

planner:
  enhsp_jar: "planners/enhsp/enhsp-20.jar"  # ENHSP executable jar.
  java_heap_mb: 8192                        # Java heap for ENHSP; raise for large PDDL.
  traversal_model: "compiled_duration"      # "process" or "compiled_duration".
  state_representation: "node_based"        # "node_based" or "line_graph".
  action_generation: "parameterized"        # "parameterized" or "compiled".

# Planner mode notes:
# process + node_based + parameterized:
#   Full PDDL+ model with start action, process, and arrival event.
# compiled_duration + node_based + parameterized:
#   One generic action over vehicle, road, from-location, and to-location.
# compiled_duration + node_based + compiled:
#   Python emits only valid road/location/window schemas using singleton types.
# compiled_duration + line_graph + parameterized:
#   Vehicle state is a road. Generic actions move from road to next road.
# compiled_duration + line_graph + compiled:
#   Vehicle state is a road. Python emits only valid road-to-road transitions.
#
# In line_graph mode, scenario start/goal are still selected as nodes.
# During PDDL generation a deterministic shortest path is computed on the
# directed planning graph, weighted by road length and tie-broken by road id.
# The first road of that path becomes the initial ready-road.
# The last road of that path becomes the unique goal-road.

sumo:
  sumo_gui: "sumo-gui"  # SUMO GUI command.

features:
  traffic_lights:
    enabled: true       # Adds average traffic-light wait to traversal cost.
    green_duration:
      min: 20           # Minimum sampled green duration in seconds.
      max: 30           # Maximum sampled green duration in seconds.
    yellow_duration:
      min: 3            # Minimum sampled yellow duration in seconds.
      max: 6            # Maximum sampled yellow duration in seconds.
    red_duration:
      min: 20           # Minimum sampled red duration in seconds.
      max: 30           # Maximum sampled red duration in seconds.

  road_abstraction:
    enabled: true                    # Enables macro-road compression.
    max_segments_per_macro: 8         # Maximum micro-roads fused into one macro-road.
    max_length_meters: 1500           # Maximum macro-road physical length.
    speed_tolerance_ratio: 0.15       # Maximum speed variation allowed inside a macro-road.
    require_same_capacity_class: true # Stop fusion when capacity class changes.

  congestion:
    enabled: true                   # Enables congestion generation.
    mode: "pddl"                    # "pddl" passes congestion to ENHSP; "sumo" keeps it in SUMO.
    type: "static"                  # "static", "dynamic", or "hybrid".
    replanning: false               # true activates the congestion controller branch.
    num_background_vehicles: 200    # Background vehicles used to estimate traffic load.
    congestion_factor: 2.0          # Maximum slowdown factor.
    dynamic:
      window_seconds: 30            # Duration of each global congestion window.
      hybrid:
        min_temporal_variation: 0.10 # Road becomes dynamic only above this window variation.
    vehicles_for_max_congestion_by_road_class:
      local: 20                     # Vehicles for max congestion on local roads.
      arterial: 35                  # Vehicles for max congestion on arterial roads.
      major: 50                     # Vehicles for max congestion on major roads.

  controller:
    replan_window_seconds: 30       # Offline controller replanning interval.
    max_iterations: 50              # Maximum partial planner calls.

  llm_events:
    enabled: true                   # Enables LLM event generation after the base plan.
    strategic_injection: true       # LLM receives compact topology and chooses important roads.
    prevent_unsolvable_blocks: true # Converts path-breaking closures to fallback events.
    unsolvable_fallback: "slowdown" # "slowdown" or "skip".
    unsolvable_fallback_severity: 5.0 # Slowdown factor used by fallback events.

  sumo:
    plans:
      - base                        # Simulate the original plan.
      - dynamic                     # Simulate the LLM-recalculated plan.
    open_event_map: true            # Open the event comparison map.
    open_congestion_map: true       # Open pre/post congestion maps.

  fuel:
    enabled: false                  # Enables fuel constraints.
    replanning: false               # true activates the fuel controller branch.
    stations_ratio: 0.15            # Fraction of nodes used as fuel stations.
    initial_fuel_ratio: 0.8         # Initial tank level as fraction of capacity.
    stations_source: random         # "random" or "osm".
    consumption_mode: continuous    # "discrete" or "continuous"; compiled_duration requires discrete.
    refuel_stop_seconds: 10.0       # Extra refuel time when refuelling is represented.
